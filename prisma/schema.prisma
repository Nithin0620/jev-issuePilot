generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("member")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// IssuePilot Decision Models
model Issue {
  id                    String   @id @default(cuid())
  title                 String
  body                  String
  repository            String?  @default("default")

  // GitHub Metadata
  githubIssueNumber     Int?
  githubDeliveryId      String?  @unique
  githubSynced          Boolean  @default(false)
  appliedLabels         String[] @default([])

  // AI Decision Outputs
  category              String
  categoryConfidence    Float
  severity              Float
  severityConfidence    Float
  escalationProbability Float
  priority              String
  suggestedTeam         String   @default("Triage")
  rawProbabilities      Json?

  // Human Review & Operational Control
  needsReview           Boolean  @default(false)
  humanReviewed         Boolean  @default(false)
  humanCategory         String?
  humanPriority         String?
  humanNotes            String?

  // Model & Execution Metadata
  model                 String
  inputTokens           Int?
  outputTokens          Int?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([needsReview, humanReviewed])
  @@index([createdAt])
  @@index([repository])
  @@index([category])
  @@index([priority])
}

model Repository {
  id                  String    @id @default(cuid())
  fullName            String    @unique
  name                String
  owner               String
  description         String?
  language            String?   @default("TypeScript")
  isPrivate           Boolean   @default(false)
  connectionMode      String    @default("demo")
  webhookActive       Boolean   @default(true)
  autoSyncLabels      Boolean   @default(true)
  minConfidence       Float     @default(0.75)
  escalationThreshold Float     @default(0.85)
  defaultTeam         String    @default("Core Engineering")
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model WorkspaceConfig {
  id                   String   @id @default("default")
  organizationName     String   @default("Acme Cloud Engineering")
  githubConnected      Boolean  @default(false)
  githubConnectionMode String   @default("none")
  githubUsername       String?
  githubTokenHint      String?
  githubToken          String?
  onboardingCompleted  Boolean  @default(false)
  defaultMinConfidence Float    @default(0.75)
  defaultEscalation    Float    @default(0.85)
  autoSyncLabels       Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}
